rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if true; // Allow fetching user info (needed for 2FA check and login)
      allow list: if true; // Allow querying for user by email
      allow create: if true; // Allow initial registration
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Password Entry Rules
    match /passwords/{passwordId} {
      function isValidPasswordEntry(data) {
        return data.userId == request.auth.uid
          && data.sourceName is string && data.sourceName.size() > 0 && data.sourceName.size() <= 100
          && data.username is string && data.username.size() <= 100
          && data.encryptedPassword is string && data.encryptedPassword.size() <= 2000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidPasswordEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && isValidPasswordEntry(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
