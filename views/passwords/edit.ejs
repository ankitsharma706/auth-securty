<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto">
    <a href="/passwords" class="flex items-center gap-2 text-slate-500 hover:text-blue-600 mb-6 text-sm transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to Vault
    </a>

    <div class="glass p-8 rounded-3xl">
        <h1 class="text-2xl font-bold space-grotesk mb-2">Edit Credentials</h1>
        <p class="text-slate-500 mb-8">Update the details for <span class="text-blue-600 font-bold"><%= password.sourceName %></span>.</p>

        <form action="/passwords/update/<%= password.id %>" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Source Name</label>
                    <input type="text" name="sourceName" value="<%= password.sourceName %>" required class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white/50 focus:ring-2 focus:ring-blue-500 outline-none transition-all placeholder:text-slate-350">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Category</label>
                    <select name="category" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white/50 focus:ring-2 focus:ring-blue-500 outline-none transition-all appearance-none cursor-pointer">
                        <% ['Social', 'Work', 'Finance', 'Personal', 'Shopping', 'Other'].forEach(cat => { %>
                            <option value="<%= cat %>" <%= password.category === cat ? 'selected' : '' %>><%= cat %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Username / Email</label>
                    <input type="text" name="username" value="<%= password.username %>" required class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white/50 focus:ring-2 focus:ring-blue-500 outline-none transition-all placeholder:text-slate-350">
                </div>
                
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Password</label>
                    <div class="relative">
                        <input type="password" id="passwordField" name="password" value="<%= password.decryptedPassword %>" required class="w-full pl-4 pr-20 py-3 rounded-xl border border-slate-200 bg-white/50 focus:ring-2 focus:ring-blue-500 outline-none transition-all font-mono tracking-wider">
                        <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
                            <button type="button" id="togglePasswordBtn" class="p-1.5 text-slate-400 hover:text-blue-500 transition-colors" title="Toggle Visibility">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                            <button type="button" id="foldGeneratorBtn" class="p-1.5 text-slate-400 hover:text-blue-500 transition-colors" title="Toggle Password Generator">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Password strength visual tracker -->
                    <div class="mt-2 text-xs text-slate-500">
                        <div class="flex gap-1.5 mt-1" id="strengthBar">
                            <div class="h-1.5 flex-1 bg-slate-200 rounded transition-all duration-300"></div>
                            <div class="h-1.5 flex-1 bg-slate-200 rounded transition-all duration-300"></div>
                            <div class="h-1.5 flex-1 bg-slate-200 rounded transition-all duration-300"></div>
                            <div class="h-1.5 flex-1 bg-slate-200 rounded transition-all duration-300"></div>
                        </div>
                        <div class="flex justify-between items-center mt-1.5">
                            <span id="strengthText" class="font-bold text-[10px] uppercase text-slate-400 tracking-wider">Strength: Empty</span>
                            <span id="strengthAdvice" class="text-[10px] text-slate-400">Choose a smart password</span>
                        </div>
                    </div>

                    <!-- Fold-down Password Generator Pane -->
                    <div id="generatorPane" class="hidden mt-4 p-4 rounded-2xl bg-slate-50/80 border border-slate-200/50 space-y-4">
                        <div class="flex justify-between items-center">
                            <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">Parameters</span>
                            <span class="text-xs font-bold text-blue-600 font-mono" id="lengthDisplay">Length: 16</span>
                        </div>
                        
                        <div class="space-y-1">
                            <input type="range" id="lengthSlider" min="8" max="64" value="16" class="w-full accent-blue-600 cursor-pointer">
                        </div>

                        <div class="grid grid-cols-2 gap-3 text-xs">
                            <label class="flex items-center gap-2 text-slate-600 select-none cursor-pointer">
                                <input type="checkbox" id="chkUpper" checked class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
                                Uppercase (A-Z)
                            </label>
                            <label class="flex items-center gap-2 text-slate-600 select-none cursor-pointer">
                                <input type="checkbox" id="chkLower" checked class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
                                Lowercase (a-z)
                            </label>
                            <label class="flex items-center gap-2 text-slate-600 select-none cursor-pointer">
                                <input type="checkbox" id="chkNumbers" checked class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
                                Digits (0-9)
                            </label>
                            <label class="flex items-center gap-2 text-slate-600 select-none cursor-pointer">
                                <input type="checkbox" id="chkSymbols" checked class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
                                Symbols (#$@!%*)
                            </label>
                        </div>

                        <button type="button" id="triggerGenBtn" class="w-full py-2.5 bg-white hover:bg-slate-100 border border-slate-200 text-blue-600 font-bold rounded-xl text-xs transition-colors shadow-sm active:scale-95">
                            Generate & Apply Secret
                        </button>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Notes (Optional)</label>
                <textarea name="notes" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white/50 focus:ring-2 focus:ring-blue-500 outline-none transition-all placeholder:text-slate-350"><%= password.notes %></textarea>
            </div>

            <div class="flex pt-4">
                <button type="submit" class="w-full py-4 button-gradient text-white rounded-xl font-bold shadow-lg shadow-blue-500/20 hover:scale-[1.01] active:scale-95 transition-all text-sm tracking-wide">
                    Update Credential
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const passwordField = document.getElementById('passwordField');
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const foldBtn = document.getElementById('foldGeneratorBtn');
    const genPane = document.getElementById('generatorPane');
    const lengthSlider = document.getElementById('lengthSlider');
    const lengthDisplay = document.getElementById('lengthDisplay');
    const triggerGenBtn = document.getElementById('triggerGenBtn');

    // Toggle Plaintext
    toggleBtn.addEventListener('click', () => {
        const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordField.setAttribute('type', type);
        toggleBtn.querySelector('svg').innerHTML = type === 'password' 
            ? `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`
            : `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 1.24-2.13M9.9 4.24A10.07 10.07 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>`;
    });

    // Toggle Generator Panel
    foldBtn.addEventListener('click', () => {
        genPane.classList.toggle('hidden');
    });

    // Update Slider text
    lengthSlider.addEventListener('input', (e) => {
        lengthDisplay.textContent = `Length: ${e.target.value}`;
    });

    // Generate action
    triggerGenBtn.addEventListener('click', () => {
        const length = parseInt(lengthSlider.value);
        const hasUpper = document.getElementById('chkUpper').checked;
        const hasLower = document.getElementById('chkLower').checked;
        const hasNumbers = document.getElementById('chkNumbers').checked;
        const hasSymbols = document.getElementById('chkSymbols').checked;

        let chars = "";
        if (hasUpper) chars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        if (hasLower) chars += "abcdefghijklmnopqrstuvwxyz";
        if (hasNumbers) chars += "0123456789";
        if (hasSymbols) chars += "#$@!%*?&=-+()[]{}";

        if (chars === "") {
            alert("Please check at least one character set parameter.");
            return;
        }

        // Use standard cryptographically secure browser API
        let generated = "";
        const array = new Uint32Array(length);
        window.crypto.getRandomValues(array);
        for (let i = 0; i < length; i++) {
            generated += chars[array[i] % chars.length];
        }

        passwordField.value = generated;
        // Turn field visible to inspect it
        passwordField.setAttribute('type', 'text');
        toggleBtn.querySelector('svg').innerHTML = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 1.24-2.13M9.9 4.24A10.07 10.07 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>`;

        analyzeStrength(generated);
    });

    // Strength tracking
    const bars = document.querySelectorAll('#strengthBar > div');
    const sText = document.getElementById('strengthText');
    const sAdvice = document.getElementById('strengthAdvice');

    function analyzeStrength(val) {
        if (!val) {
            bars.forEach(b => b.className = 'h-1.5 flex-1 bg-slate-200 rounded');
            sText.textContent = "Strength: Empty";
            sText.className = "font-bold text-[10px] uppercase text-slate-400 tracking-wider";
            sAdvice.textContent = "Choose a smart password";
            return;
        }

        let score = 0;
        if (val.length >= 8) score += 1;
        if (val.length >= 12) score += 2;
        if (val.length >= 16) score += 1;
        if (/[A-Z]/.test(val)) score += 1;
        if (/[a-z]/.test(val)) score += 1;
        if (/[0-9]/.test(val)) score += 1;
        if (/[^A-Za-z0-9]/.test(val)) score += 1;

        // Reset
        bars.forEach(b => b.className = 'h-1.5 flex-1 bg-slate-200 rounded');

        if (score <= 3) {
            // Very Weak
            bars[0].className = 'h-1.5 flex-1 bg-red-500 rounded';
            sText.textContent = "Strength: Very Weak";
            sText.className = "font-bold text-[10px] uppercase text-red-500 tracking-wider";
            sAdvice.textContent = "Tip: Make it longer + mix types";
        } else if (score === 4 || score === 5) {
            // Moderate
            bars[0].className = 'h-1.5 flex-1 bg-orange-400 rounded';
            bars[1].className = 'h-1.5 flex-1 bg-orange-400 rounded';
            sText.textContent = "Strength: Moderate";
            sText.className = "font-bold text-[10px] uppercase text-orange-500 tracking-wider";
            sAdvice.textContent = "Tip: Add special characters";
        } else if (score === 6) {
            // Strong
            bars[0].className = 'h-1.5 flex-1 bg-yellow-400 rounded';
            bars[1].className = 'h-1.5 flex-1 bg-yellow-400 rounded';
            bars[2].className = 'h-1.5 flex-1 bg-yellow-400 rounded';
            sText.textContent = "Strength: Strong";
            sText.className = "font-bold text-[10px] uppercase text-yellow-600 tracking-wider";
            sAdvice.textContent = "Excellent defense level";
        } else {
            // Excellent
            bars[0].className = 'h-1.5 flex-1 bg-emerald-500 rounded';
            bars[1].className = 'h-1.5 flex-1 bg-emerald-500 rounded';
            bars[2].className = 'h-1.5 flex-1 bg-emerald-500 rounded';
            bars[3].className = 'h-1.5 flex-1 bg-emerald-500 rounded';
            sText.textContent = "Strength: Military Grade";
            sText.className = "font-bold text-[10px] uppercase text-emerald-600 tracking-wider";
            sAdvice.textContent = "Ideal cryptographic shield";
        }
    }

    // Trigger initial analysis for loaded value
    if (passwordField.value) {
        analyzeStrength(passwordField.value);
    }

    passwordField.addEventListener('input', (e) => {
        analyzeStrength(e.target.value);
    });
});
</script>

<%- include('../partials/footer') %>
