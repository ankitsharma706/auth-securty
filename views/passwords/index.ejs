<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold space-grotesk">Your Vault</h1>
            <p class="text-slate-500">Securely managing all your credentials.</p>
        </div>
        <div class="flex items-center gap-4">
            <form action="/passwords/search" method="GET" class="relative">
                <input type="text" name="query" placeholder="Search entries..." class="pl-10 pr-4 py-2 rounded-xl bg-white/50 border border-slate-200 outline-none focus:ring-2 focus:ring-blue-500 w-64">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </form>
            <a href="/passwords/new" class="px-5 py-2.5 button-gradient text-white rounded-xl font-semibold shadow-md active:scale-95 text-sm">Add New</a>
        </div>
    </div>

    <div class="glass rounded-3xl overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-100 bg-slate-50/50">
                    <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Source</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Username/Email</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest">Password</th>
                    <th class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-widest text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <% if (passwords.length === 0) { %>
                    <tr>
                        <td colspan="4" class="px-6 py-20 text-center text-slate-400">No passwords found.</td>
                    </tr>
                <% } else { %>
                    <% passwords.forEach(pw => { %>
                        <tr class="hover:bg-blue-50/30 transition-colors group">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center font-bold text-xs"><%= pw.sourceName.charAt(0).toUpperCase() %></div>
                                    <div>
                                        <div class="font-bold text-slate-700"><%= pw.sourceName %></div>
                                        <div class="text-[10px] bg-slate-100 text-slate-500 px-1.5 rounded uppercase font-bold inline-block mt-0.5"><%= pw.category %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600"><%= pw.username %></td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="password-field font-mono text-sm tracking-tighter" data-password="<%= pw.decryptedPassword %>">••••••••</span>
                                    <button class="p-1.5 hover:bg-white rounded-lg text-slate-400 hover:text-blue-600 transition-colors toggle-visibility" title="Show/Hide">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-icon"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    <button class="p-1.5 hover:bg-white rounded-lg text-slate-400 hover:text-blue-600 transition-colors copy-btn" data-copy="<%= pw.decryptedPassword %>" title="Copy">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                    </button>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/passwords/edit/<%= pw.id %>" class="p-2 hover:bg-blue-100 text-blue-600 rounded-lg transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                    <form action="/passwords/delete/<%= pw.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this password?')">
                                        <button type="submit" class="p-2 hover:bg-red-100 text-red-600 rounded-lg transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
