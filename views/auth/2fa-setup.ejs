<%- include('../partials/header') %>

<div class="max-w-md mx-auto mt-16">
    <div class="glass p-8 rounded-[2rem]">
        <h1 class="text-2xl font-bold space-grotesk text-center mb-2">Two-Factor Authentication</h1>
        <p class="text-slate-500 text-center mb-8 text-sm">Scan the QR code with your authenticator app (Google Authenticator, Authy, etc.)</p>

        <% if (error) { %>
            <div class="bg-red-50 border border-red-100 text-red-600 px-4 py-3 rounded-xl mb-6 text-sm">
                <%= error %>
            </div>
        <% } %>

        <div class="flex flex-col items-center gap-6">
            <% if (qrCodeDataUrl) { %>
                <div class="p-4 bg-white rounded-2xl shadow-sm border border-slate-100">
                    <img src="<%= qrCodeDataUrl %>" alt="QR Code" class="w-48 h-48">
                </div>
                <div class="text-center">
                    <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">Manual Entry Key</p>
                    <code class="text-xs bg-slate-100 px-2 py-1 rounded text-slate-600"><%= secret %></code>
                </div>
            <% } %>

            <form action="/2fa/verify" method="POST" class="w-full space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-1 px-1">Verification Code</label>
                    <input type="text" name="token" required class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white/50 focus:ring-2 focus:ring-blue-500 outline-none text-center text-2xl tracking-[0.5em] font-mono" placeholder="000000" maxlength="6">
                </div>
                <button type="submit" class="w-full py-3 button-gradient text-white rounded-xl font-bold shadow-lg shadow-blue-500/20 active:scale-95">Enable 2FA</button>
            </form>
            
            <a href="/dashboard" class="text-sm text-slate-400 hover:text-slate-600">Cancel and Return</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
